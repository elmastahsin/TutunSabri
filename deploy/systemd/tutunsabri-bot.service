[Unit]
Description=TutunSabri Telegram Bot
After=network.target redis-server.service
Requires=redis-server.service
PartOf=tutunsabri.target

[Service]
Type=simple
User=tahsin
Group=tahsin
WorkingDirectory=/home/tahsin/server/TutunSabri
Environment=HOME=/home/tahsin
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/tahsin/server/TutunSabri/.venv/bin/python bot.py
Restart=always
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=tutunsabri.target
